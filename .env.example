POSTGRES_USER=aboutme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aboutme

# Первый админ, только если таблица users пустая. Дальше учётки в Postgres.
# Хэш обязательно в одинарных кавычках: иначе Docker Compose читает $… внутри
# как переменные и молча обрезает хэш до pbkdf2_sha256$600000.
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH='pbkdf2_sha256$600000$replace_salt$replace_hash'
SESSION_SECRET=replace-with-long-random-string

# Локально раскомментируй, чтобы не занимать порт 80.
# На VPS не задавай — будет 80.
# NGINX_HTTP_PORT=8080
