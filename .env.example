POSTGRES_USER=aboutme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aboutme

# Первый админ, только если таблица users пустая. Дальше учётки в Postgres.
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=pbkdf2_sha256$200000$replace_salt$replace_hash
SESSION_SECRET=replace-with-long-random-string

# Локально раскомментируй, чтобы не занимать порт 80.
# На VPS не задавай — будет 80.
# NGINX_HTTP_PORT=8080

# Aurum (money.koppa0.dev). Свой Postgres, не aboutme.
AURUM_POSTGRES_PASSWORD=changeme-aurum
AURUM_ALLOWED_HOSTS=money.koppa0.dev
AURUM_CORS_ORIGINS=https://money.koppa0.dev
# AURUM_DEFAULT_CURRENCY=RUB

# AdventureLog (travel.koppa0.dev). Свой PostGIS, не aboutme.
# После первого входа смени пароль админки AdventureLog.
ADVENTURELOG_POSTGRES_PASSWORD=changeme-adventurelog
ADVENTURELOG_ADMIN_USERNAME=admin
ADVENTURELOG_ADMIN_PASSWORD=changeme-adventurelog-admin
ADVENTURELOG_ADMIN_EMAIL=admin@koppa0.dev
ADVENTURELOG_SITE_URL=https://travel.koppa0.dev
