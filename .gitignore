# Секреты: настоящий .env есть только локально и на сервере.
.env
.env.*
!.env.example
# На всякий случай: однажды в историю уже попал файл с кукой сессии.
cookies.txt

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.python-version
.pytest_cache/
.ruff_cache/

